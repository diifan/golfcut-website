[Service]
Type=oneshot
User=swi-codex
Group=swi-codex
WorkingDirectory=/data/swi-algo/Swi-App-Factory/GolfCut
Environment=PATH=/var/lib/swi-codex/.bun/bin:/var/lib/swi-codex/agent-relay/bin:/usr/local/bin:/usr/bin:/bin
